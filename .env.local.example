# TERRALIGN 2.0 — Environment Variables
# Copy this file to .env.local and fill in your API keys.
# These keys are NEVER exposed to the browser runtime (server-side only).

# Google Gemini API Key & Model Configuration (optional — deterministic fallback is always available)
# Obtain from: https://aistudio.google.com/app/apikey
# Operational Default: gemini-2.5-flash
# Note: Google restricts 2.5 Flash access to eligible existing users and recommends newer models for new projects.
# Fully configurable: set GEMINI_MODEL to any supported model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GroqCloud API Key & Model Configuration (optional — deterministic fallback is always available)
# Obtain from: https://console.groq.com/keys
# Operational Default: openai/gpt-oss-120b (Endpoint: https://api.groq.com/openai/v1/chat/completions)
# Fully configurable: set GROQ_MODEL (or legacy GROK_MODEL) to any accessible GroqCloud model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Render Backend Configuration (Optional for Vercel -> Render proxying)
# Set RENDER_BACKEND_URL in Vercel to transparently route all /api/* requests to your Render service.
# RENDER_BACKEND_URL=https://terralign-backend.onrender.com
# NEXT_PUBLIC_API_URL=https://terralign-backend.onrender.com
